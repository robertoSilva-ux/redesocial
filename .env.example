# Copie para `.env` (`cp .env.example .env`) e ajuste o que precisar.
# Rodando via Docker, o docker-compose.yml sobrescreve DATABASE_URL e PORT
# com os valores válidos dentro do container.

# Banco SQLite local (caminho relativo à raiz do projeto).
DATABASE_URL="file:./dev.db"

# Porta publicada no host.
PORT=3003

# Assina o cookie de sessão. Em produção viria de um secret manager.
SESSION_SECRET="aula05-segredo-de-desenvolvimento"

# Logs internos do Prisma — úteis para mostrar as queries em aula, mas MUITO
# verbosos. Descomente só quando quiser ver.
# DEBUG="prisma*"

# Upload de imagens: se AS DUAS estiverem preenchidas, a aplicação usa S3 de
# verdade; caso contrário grava em `uploads/` e serve pelo próprio Express
# (ver src/uploads/createImageStorage.ts).
# AWS_S3_BUCKET=""
# AWS_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
