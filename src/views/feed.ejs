<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aula 05 - Feed</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-100 min-h-screen">
    <header class="bg-slate-900 text-white px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <% if (currentUser.avatarUrl) { %>
          <img src="<%= currentUser.avatarUrl %>" alt="" class="w-9 h-9 rounded-full object-cover" />
        <% } %>
        <div>
          <h1 class="text-lg font-semibold">Rede social — Aula 05</h1>
          <p class="text-slate-300 text-sm">
            Logado como <strong><%= currentUser.name %></strong>
            (<%= currentUser._count.following %> seguindo, <%= currentUser._count.followers %> seguidores)
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/posts/new" class="bg-white text-slate-900 text-sm rounded px-3 py-1.5 hover:bg-slate-200">
          Novo post
        </a>
        <form method="post" action="/logout">
          <button type="submit" class="text-slate-300 text-sm hover:text-white">Sair</button>
        </form>
      </div>
    </header>

    <main class="max-w-4xl mx-auto mt-8 px-4 grid grid-cols-1 md:grid-cols-3 gap-6">
      <section class="md:col-span-2 flex flex-col gap-4">
        <h2 class="text-slate-500 text-sm font-medium uppercase tracking-wide">Seu feed</h2>

        <% if (feed.length === 0) { %>
          <p class="bg-white rounded-lg shadow p-6 text-sm text-slate-500">
            Ninguém que você segue postou ainda. Siga alguém na coluna ao lado.
          </p>
        <% } %>

        <% feed.forEach((post) => { %>
          <%# ATIVIDADE: enquanto o backend não devolver esses dados, o feed mostra 0/0 %>
          <% const likeCount = post._count?.likes ?? 0; %>
          <% const commentCount = post._count?.comments ?? 0; %>
          <% const likedByMe = post.likedByMe ?? false; %>
          <article class="bg-white rounded-lg shadow p-4">
            <header class="flex items-center justify-between">
              <p class="text-sm font-medium text-slate-800"><%= post.author.name %></p>
              <p class="text-xs text-slate-400"><%= new Date(post.createdAt).toLocaleString('pt-BR') %></p>
            </header>
            <a href="/posts/<%= post.id %>" class="block group">
              <p class="text-slate-700 mt-2 group-hover:text-slate-900"><%= post.content %></p>
              <% if (post.imageUrl) { %>
                <img src="<%= post.imageUrl %>" alt="" class="mt-3 rounded-lg max-h-80 w-full object-cover" />
              <% } %>
            </a>
            <% if (post.tags.length > 0) { %>
              <div class="flex gap-2 mt-3 flex-wrap">
                <% post.tags.forEach((tag) => { %>
                  <span class="text-xs bg-slate-100 text-slate-600 rounded-full px-2 py-0.5">#<%= tag.name %></span>
                <% }) %>
              </div>
            <% } %>
            <footer class="flex items-center gap-4 mt-3 pt-3 border-t border-slate-100">
              <%# ATIVIDADE: este form ainda não tem rota no backend %>
              <form method="post" action="/posts/<%= post.id %>/like">
                <button
                  type="submit"
                  title="Curtir"
                  class="flex items-center gap-1.5 text-sm <%= likedByMe ? 'text-rose-600' : 'text-slate-500' %> hover:text-rose-600"
                >
                  <svg viewBox="0 0 24 24" class="w-5 h-5" fill="<%= likedByMe ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                  </svg>
                  <span><%= likeCount %></span>
                </button>
              </form>
              <a href="/posts/<%= post.id %>" title="Comentários" class="flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-800">
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75h6.75m-6.75 3h4.5M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25-9 3.694-9 8.25c0 1.6.497 3.096 1.356 4.36.1.148.14.33.107.507l-.713 3.133 3.94-1.02c.16-.042.33-.02.48.043 1.15.49 2.45.767 3.83.767Z" />
                </svg>
                <span><%= commentCount %></span>
              </a>
              <% if (post.authorId === currentUser.id) { %>
                <form method="post" action="/posts/<%= post.id %>/delete" class="ml-auto">
                  <button type="submit" class="text-xs text-red-600 hover:underline">Apagar</button>
                </form>
              <% } %>
            </footer>
          </article>
        <% }) %>
      </section>

      <aside class="flex flex-col gap-3">
        <h2 class="text-slate-500 text-sm font-medium uppercase tracking-wide">Pessoas</h2>
        <div class="bg-white rounded-lg shadow divide-y">
          <% others.forEach((user) => { %>
            <div class="flex items-center justify-between px-4 py-3">
              <span class="text-sm text-slate-700"><%= user.name %></span>
              <% if (user.isFollowing) { %>
                <span class="text-xs text-slate-400">Já segue</span>
              <% } else { %>
                <form method="post" action="/follow">
                  <input type="hidden" name="targetId" value="<%= user.id %>" />
                  <button type="submit" class="text-xs bg-slate-800 text-white rounded px-2 py-1 hover:bg-slate-700">
                    Seguir
                  </button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      </aside>
    </main>
  </body>
</html>
