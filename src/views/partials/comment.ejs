<%#
  Um comentário, usado pelo feed (Aula 05 → Trabalho II) e pela página do post.

  Precisa de `comment` e `currentUser` no escopo (locals do res.render).
  `comment` deve trazer `author` (campos públicos), `_count.likes` e
  `likedByMe` — os dois Controllers que listam comentários preenchem isso.

  `data-comment-id`, `data-comment-content`, `data-comment-like` e
  `data-comment-delete` são os ganchos da delegação de eventos em
  public/feed.js: o mesmo listener cobre o comentário recém-inserido.
%>
<li class="flex items-start gap-2 text-sm" data-comment-id="<%= comment.id %>">
  <p class="flex-1 text-slate-700">
    <strong class="text-slate-800"><%= comment.author.name %></strong>
    <span data-comment-content><%= comment.content %></span>
  </p>

  <%# Curtida do comentário (atividade 3). Mesma forma do botão de post, para o
      `toggleLike` do feed.js servir aos dois alvos sem bifurcação. %>
  <form method="post" action="/comments/<%= comment.id %>/like" data-comment-like>
    <button
      type="submit"
      title="Curtir comentário"
      data-liked="<%= comment.likedByMe ? '1' : '0' %>"
      aria-pressed="<%= comment.likedByMe ? 'true' : 'false' %>"
      class="flex items-center gap-1 text-xs <%= comment.likedByMe ? 'text-rose-600' : 'text-slate-400' %> hover:text-rose-600"
    >
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="<%= comment.likedByMe ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
      </svg>
      <span data-like-count><%= comment._count?.likes ?? 0 %></span>
    </button>
  </form>

  <% if (comment.authorId === currentUser.id) { %>
    <form method="post" action="/comments/<%= comment.id %>/delete" data-comment-delete>
      <button type="submit" class="text-xs text-red-600 hover:underline">apagar</button>
    </form>
  <% } %>
</li>
