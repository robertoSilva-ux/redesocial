<%#
  Um comentário, usado pelo feed e pela página do post (via postCard.ejs).

  Precisa de `comment` e `currentUser` no escopo (locals do res.render).
  `comment` deve trazer `author` (campos públicos), `_count.likes` e
  `likedByMe` — os dois Controllers que listam comentários preenchem isso.

  `data-comment-id`, `data-comment-content`, `data-comment-like`,
  `data-comment-delete`, `data-comment-edit` e `data-comment-edit-form` são os
  ganchos da delegação de eventos em public/feed.js: o mesmo listener cobre o
  comentário recém-inserido.

  Edição (atividade 7) tem dois caminhos, como manda o ADR-0004: com JS o botão
  "editar" troca o texto por um campo e o `fetch` usa PATCH; sem JS, o form
  manda POST para `/comments/:id/edit` e a página recarrega.
%>
<% const editado = comment.updatedAt && comment.updatedAt > comment.createdAt; %>
<li class="flex flex-wrap items-start gap-2 text-sm" data-comment-id="<%= comment.id %>">
  <p class="flex-1 text-slate-700">
    <strong class="text-slate-800 mr-1"><%= comment.author.name %></strong>
    <span data-comment-content><%= comment.content %></span>
    <% if (editado) { %>
      <span class="text-xs text-slate-400" data-comment-edited>(editado)</span>
    <% } %>
  </p>

  <%# Curtida do comentário (atividade 3). Mesma forma do botão de post, para o
      `toggleLike` do feed.js servir aos dois alvos sem bifurcação. %>
  <form method="post" action="/comments/<%= comment.id %>/like" data-comment-like>
    <button
      type="submit"
      title="Curtir comentário"
      data-liked="<%= comment.likedByMe ? '1' : '0' %>"
      aria-pressed="<%= comment.likedByMe ? 'true' : 'false' %>"
      class="flex items-center gap-1 text-xs <%= comment.likedByMe ? 'text-rose-600' : 'text-slate-400' %> hover:text-rose-600"
    >
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="<%= comment.likedByMe ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
      </svg>
      <span data-like-count><%= comment._count?.likes ?? 0 %></span>
    </button>
  </form>

  <% if (comment.authorId === currentUser.id) { %>
    <div class="flex items-center gap-2">
      <button type="button" data-comment-edit class="text-xs text-slate-500 hover:underline">editar</button>
      <form method="post" action="/comments/<%= comment.id %>/delete" data-comment-delete>
        <button type="submit" class="text-xs text-red-600 hover:underline">apagar</button>
      </form>
    </div>

    <form
      method="post"
      action="/comments/<%= comment.id %>/edit"
      class="hidden basis-full flex gap-2 mt-1"
      data-comment-edit-form
    >
      <input
        type="text"
        name="content"
        value="<%= comment.content %>"
        required
        maxlength="2000"
        class="flex-1 border rounded px-2 py-1 text-sm"
      />
      <button type="submit" class="text-xs bg-slate-800 text-white rounded px-2 py-1">salvar</button>
      <button type="button" data-comment-edit-cancel class="text-xs text-slate-500 hover:underline">cancelar</button>
    </form>
  <% } %>
</li>
