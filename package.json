{
  "name": "aula05-rede-social",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aula 05 - frontend EJS, autenticação (bcrypt + express-session), middleware de autenticação/autorização e upload de imagens (Multer + S3) sobre o projeto de persistência da Aula 04.",
  "overrides": {
    "better-sqlite3": "^13.0.3"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "node scripts/prisma-studio.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
