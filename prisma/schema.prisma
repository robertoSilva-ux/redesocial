generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 1:N — um autor tem muitos posts.
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  // Nunca a senha em texto puro — só o hash gerado pelo bcrypt
  // (ver src/auth/passwords.ts). Mesmo um vazamento do banco não expõe a senha.
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  // Último acesso que já "consumiu" as novidades (item 10 do Trabalho II).
  // Nulo = nunca consumiu: o contador começa do zero em vez de contar todo o
  // histórico da conta (semântica registrada na ADR-0012). Não confundir com
  // `createdAt`, que é o cadastro.
  lastSeenAt DateTime?

  posts Post[]

  // Autorrelação N:N — User segue User, via tabela de junção explícita
  // (precisa ser explícita porque tem duas relações diferentes com User:
  // "quem segue" e "quem é seguido").
  following Follow[] @relation("follower")
  followers Follow[] @relation("following")

  // ---- do Exercício 1 (Aula 04), mantidos sobre o schema da Aula 05 ----
  // 1:1 — um perfil por usuário (o @unique no FK é o que garante o "1").
  profile UserProfile?

  // 1:N — comentários e likes feitos por este usuário, imagens que ele subiu.
  comments Comment[]
  likes    Like[]
  images   Image[]
}

model Follow {
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  // `imageUrl` foi removido na migration do ADR-0009: a foto do post agora é
  // uma relação 1:N com `PostImage` (com `order`), e cada arquivo continua
  // guardando só a URL — o binário vive no ImageStorage, nunca no banco.
  createdAt DateTime @default(now())

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // N:N implícita — o Prisma cria e gerencia a tabela de junção sozinho.
  tags Tag[]

  // ---- do Exercício 1 (Aula 04) ----
  comments Comment[]
  likes    Like[]

  // Fotos do post, ordenadas (Trabalho II, item 4 / ADR-0009).
  images PostImage[]

  // Arquivos do usuário presos a este post — relação do Exercício 1, mantida
  // como legado. Não é "a foto do post": `Image` pertence ao usuário e
  // sobrevive ao post (onDelete: SetNull). Ver ADR-0009.
  legacyImages Image[]
}

// Foto de um post. Diferente de `Image`: pertence ao post (Cascade), tem
// ordem explícita e não carrega metadados de arquivo.
// `@@unique([postId, order])` transforma a ordem em invariante — sem ele, duas
// fotos com a mesma `order` deixariam a leitura não determinística.
model PostImage {
  id     Int    @id @default(autoincrement())
  url    String
  order  Int    @default(0)
  postId Int
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, order])
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

// =====================================================================
// Exercício 1 da Aula 04, restaurado sobre o `init` da Aula 05.
// A migration 20261014013133_add_comment_like_userprofile_image já cria
// estas tabelas (com o CHECK de alvo exclusivo do Like escrito à mão).
// =====================================================================

// Comentário em um post. Além das duas relações obrigatórias (autor e post),
// tem autorrelação 1:N opcional: um comentário pode ser resposta de outro.
model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  likes Like[]
}

// Junção explícita com alvo exclusivo: um like aponta para UM post OU UM
// comentário. Os dois @@unique impedem like repetido do mesmo usuário;
// a regra "exatamente um alvo" é um CHECK acrescentado à mão na migration.
model Like {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId Int?
  post   Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId Int?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

// 1:1 com User: o @unique em userId é a diferença entre 1:1 e 1:N.
model UserProfile {
  id          Int       @id @default(autoincrement())
  displayName String?
  bio         String?
  location    String?
  website     String?
  birthDate   DateTime?
  isPrivate   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Arquivo de imagem de um usuário, opcionalmente preso a um post.
// Post apagado -> a imagem sobrevive com postId nulo (SetNull).
model Image {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  altText   String?
  mimeType  String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  postId Int?
  post   Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
}
